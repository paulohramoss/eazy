# ─── Firebase (cliente) ───────────────────────────────────────────────────────
# Estes valores NÃO são segredos: o Firebase os expõe no bundle por design, e a
# proteção real vem das regras do Firestore/Storage. Ficam em env só para dar
# ambientes separados (dev/staging/prod) sem editar código.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push certificate: Firebase Console > Project Settings > Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=

# ─── Bolsai (cotações) ────────────────────────────────────────────────────────
# SEGREDO. Usada pelo proxy serverless em produção e pelo proxy do Vite em dev.
# Sem prefixo VITE_ justamente para nunca entrar no bundle do cliente.
BOLSAI_API_KEY=

# ─── E-mail (notificações) ────────────────────────────────────────────────────
# SEGREDO. Use uma App Password do Google, nunca a senha da conta:
# https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
SMTP_SERVICE=gmail
# Remetente exibido. Cai em SMTP_USER se vazio.
SMTP_FROM=

# ─── Servidor ─────────────────────────────────────────────────────────────────
# Origens permitidas nas funções serverless, separadas por vírgula.
# Sem isto o CORS libera apenas localhost em dev e nada em produção.
ALLOWED_ORIGINS=https://eazy.vercel.app

# Credencial do Firebase Admin SDK, usada para validar o ID token nas funções e
# para os jobs agendados. Console > Project Settings > Service accounts >
# "Generate new private key". Cole o JSON inteiro numa linha só.
FIREBASE_SERVICE_ACCOUNT=

# Protege os endpoints de cron. A Vercel manda este valor no header
# Authorization: Bearer <CRON_SECRET> nas execuções agendadas.
CRON_SECRET=
