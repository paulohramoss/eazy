+/* ask — Pergunte ao Eazy: conversa curta sobre os próprios números. */
+
+.ask {
+  max-width: 760px;
+  margin: 0 auto;
+  display: flex;
+  flex-direction: column;
+  min-height: calc(100dvh - var(--header-height) - 80px);
+}
+
+.ask-thread {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding-bottom: 12px;
+}
+
+/* ── Abertura com sugestões ─────────────────────────────── */
+.ask-intro {
+  text-align: center;
+  padding: 32px 8px 8px;
+}
+
+.ask-intro-icon {
+  width: 52px;
+  height: 52px;
+  margin: 0 auto 14px;
+  border-radius: 16px;
+  display: grid;
+  place-items: center;
+  background: var(--accent-soft);
+  color: var(--accent);
+  font-size: 22px;
+}
+
+.ask-intro-icon .fi { display: flex; }
+
+.ask-intro h2 {
+  font-size: 20px;
+  font-weight: 700;
+  letter-spacing: -0.3px;
+  color: var(--text-primary);
+  margin: 0 0 6px;
+}
+
+.ask-intro p {
+  color: var(--text-secondary);
+  font-size: 14px;
+  margin: 0 0 18px;
+}
+
+.ask-suggestions {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 8px;
+  text-align: left;
+}
+
+.ask-suggestion {
+  background: var(--bg-card);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  padding: 12px 14px;
+  font: inherit;
+  font-size: 13.5px;
+  text-align: left;
+  line-height: 1.4;
+  color: var(--text-primary);
+  cursor: pointer;
+  transition: border-color var(--transition), background var(--transition);
+}
+
+.ask-suggestion:hover {
+  border-color: var(--accent);
+  background: var(--bg-hover);
+}
+
+/* ── Mensagens ──────────────────────────────────────────── */
+.ask-msg {
+  max-width: 85%;
+  padding: 11px 15px;
+  border-radius: 16px;
+  font-size: 14.5px;
+  line-height: 1.55;
+  overflow-wrap: anywhere;
+}
+
+.ask-msg p { margin: 0; }
+.ask-msg p + p, .ask-msg p + ul, .ask-msg ul + p { margin-top: 8px; }
+.ask-msg ul { margin: 0; padding-left: 20px; list-style: disc; }
+.ask-msg li { display: list-item; }
+.ask-msg li + li { margin-top: 3px; }
+.ask-msg strong { font-weight: 700; }
+
+.ask-msg--user {
+  align-self: flex-end;
+  background: var(--accent);
+  color: var(--btn-text, #fff);
+  border-bottom-right-radius: 5px;
+}
+
+.ask-msg--assistant {
+  align-self: flex-start;
+  background: var(--bg-card);
+  border: 1px solid var(--border);
+  color: var(--text-primary);
+  border-bottom-left-radius: 5px;
+}
+
+.ask-msg--error {
+  color: var(--accent-red);
+  border-color: rgba(var(--red-rgb), 0.35);
+}
+
+.ask-msg--loading {
+  display: flex;
+  gap: 5px;
+  padding: 15px 16px;
+}
+
+.ask-msg--loading span {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--text-muted);
+  animation: ask-dot 1.1s ease-in-out infinite;
+}
+
+.ask-msg--loading span:nth-child(2) { animation-delay: 0.15s; }
+.ask-msg--loading span:nth-child(3) { animation-delay: 0.3s; }
+
+@keyframes ask-dot {
+  0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }
+  40% { opacity: 1; transform: translateY(-3px); }
+}
+
+/* ── Campo de pergunta ──────────────────────────────────── */
+.ask-composer {
+  position: sticky;
+  bottom: 12px;
+  display: flex;
+  gap: 8px;
+  padding: 8px;
+  background: var(--bg-card);
+  border: 1px solid var(--border);
+  border-radius: 16px;
+  box-shadow: var(--shadow);
+}
+
+.ask-input {
+  flex: 1;
+  border: 0 !important;
+  background: transparent !important;
+  box-shadow: none !important;
+}
+
+.ask-input:focus,
+.ask-input:focus-visible {
+  outline: none;
+  border: 0 !important;
+  box-shadow: none !important;
+}
+
+.ask-composer:focus-within { border-color: var(--accent); }
+
+.ask-send {
+  width: 44px;
+  padding: 0 !important;
+  display: grid;
+  place-items: center;
+}
+
+.ask-send .fi { display: flex; }
+
+.ask-disclaimer {
+  text-align: center;
+  font-size: 11.5px;
+  color: var(--text-muted);
+  margin: 10px 0 0;
+}
+
+@media (max-width: 768px) {
+  .ask-suggestions { grid-template-columns: 1fr; }
+  .ask-input { font-size: 16px; }
+  .ask-msg { max-width: 92%; }
+  /* A tab bar do celular fica por cima do rodapé da página. */
+  .ask-composer { bottom: calc(76px + env(safe-area-inset-bottom, 0px)); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ask-msg--loading span { animation: none; }
+}
