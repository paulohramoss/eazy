 export const VAPID_KEY = env.VITE_FIREBASE_VAPID_KEY
   || 'BEbKBV8HkrJPiL7FAz1aBgHHu3zC0hFWOKmgz7fBnEsQQiulI2VXd_4HS3t8FzYWkx3fqOFv5c9e5o_nPTrmfLs'
 
